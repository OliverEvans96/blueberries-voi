{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist-lib"
  },
  "include": ["src/embed.ts", "src/App.tsx", "src/react/**/*.tsx", "src/react/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/main.tsx", "src/main.ts"]
}
