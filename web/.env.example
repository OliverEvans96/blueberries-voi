# Local dual-mode studio defaults (T-074 / ADR 0108).
# Copy to `.env` or `.env.local` as needed. Do not commit secrets.

# Explicit adapter: http | pyodide | mock (mock is debug-only)
# VITE_ENGINE_ADAPTER=http

# HTTP mode — local ASGI (CORS allows Vite origins; see T-073)
VITE_ENGINE_API_BASE_URL=http://127.0.0.1:8000

# Pyodide mode — Vite-served worker + local slim wheel (T-072)
VITE_PYODIDE_WORKER_URL=/packaging/pyodide/worker.js
VITE_PYODIDE_WHEEL_URL=/wheels/blueberries_voi-0.1.0-py3-none-any.whl

# WASM kernel (ADR 0120) — keep Pyodide as default until proven
# VITE_ENGINE_ADAPTER=wasm
VITE_WASM_WORKER_URL=/packaging/wasm/worker.js
VITE_WASM_PKG_URL=/wasm/
