# WASM-only studio defaults (T-125 / ADR 0129 / T-144).
# Copy to `.env` or `.env.local` as needed. Do not commit secrets.

# Explicit adapter: wasm | mock (mock is debug-only)
# VITE_ENGINE_ADAPTER=wasm

# Default path (T-144): worker + wasm pkg are bundled by Vite — no URLs required.
# Optional overrides for CDN / legacy hosting:
# VITE_WASM_WORKER_URL=https://cdn.example.com/wasmWorker.js
# VITE_WASM_ASSET_BASE_URL=https://cdn.example.com/wasm/
