# WASM-only studio defaults (T-125 / ADR 0129).
# Copy to `.env` or `.env.local` as needed. Do not commit secrets.

# Explicit adapter: wasm | mock (mock is debug-only)
# VITE_ENGINE_ADAPTER=wasm

# WASM kernel — Vite-served worker + pkg from ./scripts/build-wasm.sh
VITE_WASM_WORKER_URL=/packaging/wasm/worker.js
VITE_WASM_PKG_URL=/wasm/
